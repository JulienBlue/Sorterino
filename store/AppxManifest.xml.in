<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="JulienBlueHirte.Sorterino"
    Publisher="CN=ADB34DB7-2F09-45A8-9D01-F77F334B36D9"
    Version="@PACKAGE_VERSION@"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Sorterino</DisplayName>
    <PublisherDisplayName>Julien Blue Hirte</PublisherDisplayName>
    <Description>Dokumente lokal erkennen, prüfen und strukturiert ablegen.</Description>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Resources>
    <Resource Language="de-de" />
  </Resources>

  <Dependencies>
    <TargetDeviceFamily
      Name="Windows.Desktop"
      MinVersion="10.0.17763.0"
      MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Applications>
    <Application
      Id="Sorterino"
      Executable="Sorterino\Sorterino.exe"
      EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Sorterino"
        Description="Dokumente lokal erkennen, prüfen und strukturiert ablegen."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile
          Wide310x150Logo="Assets\Wide310x150Logo.png"
          Square310x310Logo="Assets\Square310x310Logo.png"
          ShortName="Sorterino" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#F3F3F3" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
