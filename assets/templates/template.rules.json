{
  "extraction": {
    "invoice_number_patterns": [
      "(rechnung\\s*(nr\\.?|nummer)?[:\\s\\-]*re[\\s\\-]*)([0-9][a-z0-9/\\-]{2,})",
      "(rechnung\\s*(nr\\.?|nummer)?[:\\s\\-]*)([a-z0-9/\\-]{3,})",
      "(rechn\\.\\s*nr\\.?[:\\s\\-]*)([a-z0-9/\\-]{3,})",
      "(rg[\\.\\-\\s]*nr\\.?[:\\s\\-]*)([a-z0-9/\\-]{3,})",
      "(rgnr[:\\s\\-]*)([a-z0-9/\\-]{3,})",
      "(beleg\\s*(nr\\.?|nummer)?[:\\s\\-]*)([a-z0-9/\\-]{3,})",
      "(invoice\\s*(no\\.?|number)?[:\\s\\-]*)([a-z0-9/\\-]{3,})",
      "(inv[\\.\\s]*no\\.?[:\\s\\-]*)([a-z0-9/\\-]{3,})",
      "(facture\\s*(n°|no\\.?|numero|numéro)?[:\\s\\-]*)([a-z0-9/\\-]{3,})",
      "(n°\\s*facture[:\\s\\-]*)([a-z0-9/\\-]{3,})",
      "(rechnung[_\\s\\-]*)(\\d{3,})"
    ],
    "invoice_number_blacklist": [
      "re", "ref", "re:", "nr", "awb", "pos", "summe", "seite"
    ],
    "amount_patterns": [
      "\\b\\d{1,3}(?:\\.\\d{3})*,\\d{2}\\b",
      "\\b\\d{1,3}(?:,\\d{3})*\\.\\d{2}\\b",
      "\\b\\d+[.,]\\d{2}\\b"
    ],
    "description_keywords": [
      "installation", "lizenz", "abo", "vertrag", "leistung", "service",
      "support", "wartung", "maintenance", "subscription"
    ],
    "description_blacklist": [
      "datum", "rechnung", "betrag", "mwst", "gesamt", "kunde",
      "invoice", "facture", "total", "tax", "vat"
    ],
    "description_max_length": 80,
    "description_max_words": 5,
    "vendor_blacklist": [
      "betrag", "summe", "rechnung", "datum", "seite", "total", "mwst",
      "bank", "verbindung", "bankverbindung", "iban", "bic", "konto",
      "guten tag", "vielen dank", "leistung", "zahlungsbedingungen",
      "rechnungsbetrag", "übersicht", "service", "team", "kunde",
      "invoice", "facture", "amount", "tax", "vat", "subtotal",
      "customer", "kundennummer", "client"
    ],
    "vendor_company_suffixes": [
      "gmbh", "ag", "ug", "kg", "ohg", "gbr", "ev",
      "ltd", "limited", "inc", "llc", "plc",
      "sarl", "sas", "sa", "bv", "nv"
    ],
    "vendor_address_terms": [
      "straße", "str.", "weg", "gasse", "platz", "allee", "ring",
      "street", "road", "avenue", "rue", "boulevard"
    ],
    "vendor_max_words": 5,
    "vendor_max_digits": 2,
    "vendor_scan_window": 10
  },
  "rules": [
    {
      "category": "Buchhaltung",
      "document_type": "Rechnung",
      "keywords": [
        "rechnung",
        "rechnungsnummer",
        "rg nr",
        "invoice",
        "invoice number",
        "facture",
        "zahlbar bis",
        "fällig",
        "zahlungsbedingungen",
        "gesamtbetrag",
        "amount due",
        "total ttc"
      ]
    }
  ]
}
