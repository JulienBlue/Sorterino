{
  "extraction": {
    "invoice_number_patterns": [
      "(rechnung\\s*(nr\\.?|nummer)?[:\\s\\-]*)([a-z0-9/\\-]{3,})",
      "(rechn\\.\\s*nr\\.?[:\\s\\-]*)([a-z0-9/\\-]{3,})",
      "(rg[\\.\\-\\s]*nr\\.?[:\\s\\-]*)([a-z0-9/\\-]{3,})",
      "(invoice\\s*(no\\.?|number)?[:\\s\\-]*)([a-z0-9/\\-]{3,})",
      "(rechnung[_\\s\\-]*)(\\d{3,})"
    ],
    "invoice_number_blacklist": [
      "re", "ref", "re:", "nr", "summe", "seite"
    ],
    "amount_patterns": [
      "\\b\\d{1,3}(?:\\.\\d{3})*,\\d{2}\\b",
      "\\b\\d{1,3}(?:,\\d{3})*\\.\\d{2}\\b",
      "\\b\\d+[.,]\\d{2}\\b"
    ],
    "description_keywords": [
      "installation", "lizenz", "abo", "vertrag", "leistung", "service"
    ],
    "description_blacklist": [
      "datum", "rechnung", "betrag", "mwst", "gesamt", "kunde"
    ],
    "description_max_length": 80,
    "description_max_words": 5,
    "vendor_blacklist": [
      "betrag", "summe", "rechnung", "datum", "seite", "total", "mwst",
      "bank", "verbindung", "bankverbindung", "iban", "bic", "konto",
      "guten tag", "vielen dank", "leistung", "zahlungsbedingungen",
      "rechnungsbetrag", "übersicht", "service", "team", "kunde"
    ],
    "vendor_company_suffixes": ["gmbh", "ag", "ug", "kg", "ltd"],
    "vendor_address_terms": ["straße", "str.", "gasse", "platz"],
    "vendor_max_words": 5,
    "vendor_max_digits": 2,
    "vendor_scan_window": 10
  },
  "rules": [
    {
      "category": "BUCHHALTUNG",
      "document_type": "Rechnung",
      "keywords": [
        "rechnung",
        "rechnungsnummer",
        "invoice",
        "zahlbar bis",
        "zahlungsbedingungen",
        "netto",
        "brutto",
        "gesamtbetrag",
        "amount due"
      ]
    }
  ]
}
