{
  "schema_version": 14,
  "extraction": {
    "invoice_number_patterns": [
      "(rechnung\\s*(nr\\.?|nummer)?[:\\s\\-]*re[\\s\\-]*)([0-9][a-z0-9/\\-]{2,})",
      "(rechnung\\s*(nr\\.?|nummer)?[:\\s\\-]*)([a-z0-9/\\-]{3,})",
      "(rechn\\.\\s*nr\\.?[:\\s\\-]*)([a-z0-9/\\-]{3,})",
      "(rg[\\.\\-\\s]*nr\\.?[:\\s\\-]*)([a-z0-9/\\-]{3,})",
      "(beleg\\s*(nr\\.?|nummer)?[:\\s\\-]*)([a-z0-9/\\-]{3,})",
      "(invoice\\s*(no\\.?|number)?[:\\s\\-]*)([a-z0-9/\\-]{3,})"
    ],
    "invoice_number_blacklist": ["re", "ref", "nr", "awb", "pos", "summe", "seite"],
    "amount_patterns": [
      "\\b\\d{1,3}(?:\\.\\d{3})*,\\d{2}\\b",
      "\\b\\d{1,3}(?:,\\d{3})*\\.\\d{2}\\b",
      "\\b\\d+[.,]\\d{2}\\b"
    ],
    "description_keywords": ["installation", "lizenz", "abo", "vertrag", "leistung", "service", "support", "wartung"],
    "description_blacklist": ["datum", "rechnung", "betrag", "mwst", "gesamt", "kunde", "invoice", "total", "tax"],
    "description_max_length": 80,
    "description_max_words": 5,
    "vendor_blacklist": ["betrag", "summe", "rechnung", "datum", "seite", "total", "mwst", "bankverbindung", "iban", "bic", "konto", "guten tag", "vielen dank", "zahlungsbedingungen", "kunde", "kundennummer"],
    "vendor_company_suffixes": ["gmbh", "ag", "ug", "kg", "ohg", "gbr", "ev", "ltd", "limited", "inc", "llc", "plc", "sarl", "sas", "sa", "bv", "nv"],
    "vendor_address_terms": ["straße", "str.", "weg", "gasse", "platz", "allee", "ring", "street", "road", "avenue", "rue"],
    "vendor_max_words": 5,
    "vendor_max_digits": 2,
    "vendor_scan_window": 10
  },
